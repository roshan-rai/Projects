    <worksheet name='6'>
      <table>
        <view>
          <datasources>
            <datasource caption='Car Sales Germany  Dataset' name='federated.0y277rc0i05aos1fwfuok197ng6a' />
          </datasources>
          <datasource-dependencies datasource='federated.0y277rc0i05aos1fwfuok197ng6a'>
            <column caption='Year of Registration 2' datatype='integer' name='[Calculation_1034983548538777600]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [yearOfRegistration] &lt; 1900 THEN NULL&#13;&#10;ELSEIF [yearOfRegistration] &gt; 2017 THEN NULL&#13;&#10;ELSE [yearOfRegistration]&#13;&#10;END' />
            </column>
            <column caption='lengthOfTime' datatype='integer' name='[Calculation_1289718402235219969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[dateCreated],[lastSeen])' />
            </column>
            <column caption='Dollar Amount' datatype='real' name='[Calculation_1289718402236297218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[price]*1.15' />
