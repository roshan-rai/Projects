      <aliases enabled='yes' />
      <column caption='Year of Registration 2' datatype='integer' name='[Calculation_1034983548538777600]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [yearOfRegistration] &lt; 1900 THEN NULL&#13;&#10;ELSEIF [yearOfRegistration] &gt; 2017 THEN NULL&#13;&#10;ELSE [yearOfRegistration]&#13;&#10;END' />
      </column>
      <column caption='NumberCarField' datatype='string' name='[Calculation_1289718402226835456]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([__tableau_internal_object_id__].[Autos_D271A887A4B74147981349433931C14A]) &lt; 50 THEN &quot;Very Small Number&quot;&#13;&#10;ELSEIF COUNT([__tableau_internal_object_id__].[Autos_D271A887A4B74147981349433931C14A]) &gt;= 50 AND COUNT([__tableau_internal_object_id__].[Autos_D271A887A4B74147981349433931C14A]) &lt;= 99 THEN &quot;Small Number&quot;&#13;&#10;ELSEIF COUNT([__tableau_internal_object_id__].[Autos_D271A887A4B74147981349433931C14A]) &gt;= 100 AND COUNT([__tableau_internal_object_id__].[Autos_D271A887A4B74147981349433931C14A]) &lt;= 200 THEN &quot;Medium Number&quot;&#13;&#10;ELSE &quot;Large Number&quot;&#13;&#10;END' />
      </column>
      <column caption='lengthOfTime' datatype='integer' name='[Calculation_1289718402235219969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[dateCreated],[lastSeen])' />
      </column>
      <column caption='Dollar Amount' datatype='real' name='[Calculation_1289718402236297218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price]*1.15' />
      </column>
      <column caption='Date of Registration' datatype='date' name='[Calculation_1289718402241802243]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MAKEDATE(INT([Calculation_1034983548538777600]), INT([Calculation_1289718402241937412]), 1)' />
      </column>
      <column caption='Month of Registration 2' datatype='boolean' name='[Calculation_1289718402241937412]' role='dimension' type='nominal'>
